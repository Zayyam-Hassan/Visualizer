# Application
APP_NAME="AI Room Visualizer"
APP_ENV=development
DEBUG=true

# Model configuration
# Default: nvidia/segformer-b2-finetuned-ade-512-512
# WARNING: Verify license before commercial use.
# Replace with any HuggingFace AutoModelForSemanticSegmentation-compatible model.
MODEL_NAME=nvidia/segformer-b2-finetuned-ade-512-512

# Device: auto | cpu | cuda | cuda:0
DEVICE=auto

# Optional SAM-2 refinement for mask edges (keeps SegFormer as primary segmentation).
USE_SAM2_REFINE_DEFAULT=false
SAM2_MODEL_ID=facebook/sam2-hiera-large
# Optional local-path fallback (only needed if not using SAM2_MODEL_ID):
SAM2_CONFIG_PATH=
SAM2_CHECKPOINT_PATH=

# Upload limits
MAX_UPLOAD_MB=20

# Maximum resolution for inference (longest side); 0 = no limit
MAX_INFERENCE_RESOLUTION=1024

# Output directory (relative to backend/)
OUTPUT_DIR=outputs

# CORS — comma-separated list of allowed origins
# (Note env var name is CORS_ORIGINS_RAW; the Settings class exposes a parsed list.)
CORS_ORIGINS_RAW=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
